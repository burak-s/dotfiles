# performable: sadece uygulama (nvim gibi) tuşu istemiyorsa Ghostty devreye girer.
# ctrl+v performable olmasaydi nvim'in block-visual'i ve zsh'in quote-insert'i ölürdü.
# ctrl+shift+c/v: nvim-in-tmux gibi protokol pazarliginin olmadigi durumlar icin
# her zaman calisan garanti kombinasyonlar (Linux terminal standardı).
keybind=performable:ctrl+c=copy_to_clipboard
keybind=performable:ctrl+v=paste_from_clipboard
keybind=ctrl+shift+c=copy_to_clipboard
keybind=ctrl+shift+v=paste_from_clipboard
# Koyu tema: Zed 'One Dark' ile ayni (dotfiles/config/ghostty/themes/Zed One Dark).
# nvim tarafindaki onedarkpro override'i da ayni kaynaktan (bkz. plugins.lua).
theme=dark:Zed One Dark,light:Atom One Light
shell-integration=zsh
font-family=JetBrains Mono
font-size = 10
# --- imlec: terminal (shell) imleci de cizgi olsun; nvim kendi imlecini ayrica ayarliyor
cursor-style = bar
